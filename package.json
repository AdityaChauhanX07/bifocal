{
  "name": "bifocal",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:judge-demo": "node tools/build-judge-demo.mjs",
    "firebase:preflight": "node tools/firebase-preflight.mjs",
    "test": "npm test --workspaces --if-present && node --test apps/extension/adapters/*.test.ts apps/extension/trusted-contact/*.test.ts",
    "test:trusted-contact": "node --test apps/extension/trusted-contact/firestore.emulator.ts",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p apps/extension/trusted-contact"
  },
  "devDependencies": {
    "jsdom": "27.4.0",
    "typescript": "6.0.3"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.14.7"
    }
  }
}

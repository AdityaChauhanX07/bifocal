# Firebase Web app registered for the extension
WXT_FIREBASE_API_KEY=
WXT_FIREBASE_AUTH_DOMAIN=
WXT_FIREBASE_PROJECT_ID=
WXT_FIREBASE_APP_ID=

# Chrome Extension OAuth client ID and optional override for the bundled public manifest key
WXT_GOOGLE_CLIENT_ID=
WXT_EXTENSION_KEY=

# The deployed HTTPS mintAppCheckToken endpoint
WXT_APP_CHECK_URL=
# Enable after the Firebase project is covered by the Gemini paid-service data terms
WXT_ENABLE_APPROVED_CLOUD=false

{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["chrome", "node", "vite/client"]
  },
  "include": ["entrypoints", "lib", "adapters", "trusted-contact", "wxt.config.ts"],
  "exclude": ["**/*.test.ts", "**/*.emulator.ts"]
}

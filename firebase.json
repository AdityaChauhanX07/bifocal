{
  "hosting": {
    "public": "apps/web/dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [{ "source": "/try{,/**}", "destination": "/index.html" }]
  },
  "firestore": {
    "rules": "firebase/firestore.rules"
  },
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8080 }
  },
  "functions": {
    "source": "functions",
    "ignore": ["node_modules", ".git", "firebase-debug*.log", "*.local", "test"]
  }
}
